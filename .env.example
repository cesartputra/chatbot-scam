# No API key in auto mode = labelled fixed dummy extraction, no provider call.
AI_MODE=auto
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
VISION_MODEL_NAME=gpt-4o
CHAT_MODEL_NAME=gpt-4o-mini
AI_RESPONSE_FORMAT=json_schema
AI_TIMEOUT_SECONDS=35

# Self-hosted: route vision/chat aliases through one OpenAI-compatible gateway.
# AI_MODE=remote
# AI_BASE_URL=http://127.0.0.1:4000/v1
# AI_API_KEY=your-local-gateway-key
# VISION_MODEL_NAME=qwen2.5-vl
# CHAT_MODEL_NAME=deepseek-v3
# AI_RESPONSE_FORMAT=json_object
# Keyless localhost inference is allowed with explicit AI_MODE=remote.

# Empty = in-process HTTP call to the mock ASP.NET adapter.
# Only HTTP loopback IP URLs accepted. Official/external dispatch is blocked.
IASC_WEBHOOK_URL=
# IASC_WEBHOOK_URL=http://127.0.0.1:8787/api/v1/mock-aspnet/reports
EMBED_ORIGINS="'self' http://localhost:* http://127.0.0.1:*"
